{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "jsx": "react-jsx"
  },
  "include": [
    "lib/facebook/post-to-facebook.ts",
    "tests/unit/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".test-build"
  ]
}
